NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3001
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Independent 32-byte lowercase hex key for encrypting authenticator app secrets.
# Keep stable and outside the DB; losing it disables existing authenticator app codes.
TOTP_ENCRYPTION_KEY=
DATABASE_URL=postgresql://envhandoff:local-development-only@127.0.0.1:55432/envhandoff
TEST_DATABASE_URL=postgresql://envhandoff:local-development-only@127.0.0.1:55432/envhandoff_test

# Private persistent volume without backups/versioning. Required outside development.
# Local development defaults to .data/objects relative to apps/api.
# FILE_STORAGE_PATH=/private/envhandoff-objects

# Independent durable deletion ledger, never rolled back with a metadata DB backup.
# Initialize a NEW directory once: DELETION_LEDGER_PATH=/private/envhandoff-deletions pnpm --filter @envhandoff/api deletion-ledger --init
# Required outside development; development defaults to .data/deletions (must also be initialized).
# DELETION_LEDGER_PATH=/private/envhandoff-deletions

# false stops new requests/uploads while preserving existing downloads until expiry.
PRO_ACCEPT_NEW_TRANSFERS=true
