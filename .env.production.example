# Copy to .env.production for local Compose validation, or set these in Openship.
# This is an empty template. The Dockerfile declares no secret build arguments; keep secrets in runtime settings.
WEB_ORIGIN=https://envhandoff.mabyko.com
API_ORIGIN=https://api.envhandoff.mabyko.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate independent random values; keep TOTP_ENCRYPTION_KEY stable and backed up separately from the DB.
# Each invocation prints a new 32-byte lowercase hex value:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# POSTGRES_PASSWORD must be URL-safe because it is embedded in DATABASE_URL (hex is safe).
POSTGRES_PASSWORD=
TOTP_ENCRYPTION_KEY=
# Open new requests/uploads only after deployment checks; existing downloads remain available while false.
PRO_ACCEPT_NEW_TRANSFERS=false
