{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-team-envhandoff",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "routes": [{ "pattern": "app.example.com", "custom_domain": true }],
  "vars": { "WEB_ORIGINS": "https://app.example.com" },
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "RELAY", "class_name": "RelayRoom" },
      { "name": "REQUEST_LIMITS", "class_name": "RequestLimits" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RelayRoom", "RequestLimits"] }
  ]
}
