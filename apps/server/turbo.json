{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev": { "dependsOn": ["@envhandoff/web#build"] },
    "build": {
      "dependsOn": ["^build", "typecheck", "@envhandoff/web#build"],
      "outputs": [".cloudflare/output/**"]
    },
    "test": { "dependsOn": ["^build", "@envhandoff/web#build"] }
  }
}
