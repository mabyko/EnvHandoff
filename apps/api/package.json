{
  "name": "@envhandoff/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "invite-owner": "node --env-file-if-exists=.env src/invite-owner.ts",
    "management-recovery": "node --env-file-if-exists=.env src/management-recovery.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests",
    "db:migrate": "node --env-file-if-exists=.env src/migrate.ts",
    "restore-safe": "node --env-file-if-exists=.env src/restore-safe.ts",
    "deletion-ledger": "node --env-file-if-exists=.env src/deletions.ts",
    "disable-account": "node --env-file-if-exists=.env src/disable-account.ts",
    "deletion-health": "node --env-file-if-exists=.env src/deletion-health.ts"
  },
  "dependencies": {
    "@envhandoff/protocol": "workspace:*",
    "@simplewebauthn/server": "14.0.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.15.5",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2"
  }
}
